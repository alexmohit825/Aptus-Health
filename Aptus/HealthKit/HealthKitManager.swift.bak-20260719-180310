    // ------------------------------------------------------------------
    // Engine report computation.
    //
    // Strategy: compute immediately from the latest @Published values using a
    // single-element (neutral) baseline so the UI always renders, THEN kick off
    // historical daily-series queries that recompute with real 14-/21-day
    // baselines for higher fidelity. If history is empty, the neutral baseline
    // stands (drift contribution → 0, score reflects age-norms only).
    // ------------------------------------------------------------------
    func computeEngineReports() {
        computeReportsWithBaselines(longevityBaselines: [:], recoveryBaselines: [:])
        if HKHealthStore.isHealthDataAvailable() {
            refreshBaselinesAndRecompute()
        }
    }

    private func computeReportsWithBaselines(longevityBaselines: [String: [Double]],
                                             recoveryBaselines: [String: [Double]]) {
        // --- Longevity ---
        var lInputs = LongevityInputs(age: userAge, sex: userSex)
        func lBio(_ key: String, _ latest: Double) -> BiomarkerInput {
            if let base = longevityBaselines[key], base.count > 1 {
                let recent = Array(base.suffix(7))
                return BiomarkerInput(recentValues: recent, baselineValues: base)
            }
            return BiomarkerInput(latest: latest)
        }
        if vo2Max > 0 { lInputs.vo2Max = lBio("vo2Max", vo2Max) }
        if currentHRV > 0 { lInputs.hrvSDNN = lBio("hrvSDNN", currentHRV) }
        if restingHR > 0 { lInputs.restingHR = lBio("restingHR", restingHR) }
        if sleepHoursLastNight > 0 { lInputs.sleepHours = lBio("sleepHours", sleepHoursLastNight) }
        if heartRateRecovery > 0 { lInputs.heartRateRecovery = lBio("heartRateRecovery", heartRateRecovery) }
        if walkingSpeed > 0 { lInputs.walkingSpeed = lBio("walkingSpeed", walkingSpeed) }
        if dailySteps > 0 { lInputs.steps = lBio("steps", dailySteps) }
        if exerciseMinutes > 0 { lInputs.exerciseMinutes = lBio("exerciseMinutes", exerciseMinutes) }

        let lReport = LongevityEngine().computeReport(from: lInputs)

        // --- Recovery ---
        var rInputs = RecoveryInputs()
        func rMetric(_ key: String, _ today: Double) -> RecoveryMetricInput {
            if let base = recoveryBaselines[key], base.count > 1 {
                return RecoveryMetricInput(today: today, baseline: base)
            }
            return RecoveryMetricInput(latest: today)
        }
        if currentHRV > 0 { rInputs.hrv = rMetric("hrv", currentHRV) }
        if sleepHoursLastNight > 0 { rInputs.sleepHours = rMetric("sleep", sleepHoursLastNight) }
        if restingHR > 0 { rInputs.restingHR = rMetric("rhr", restingHR) }
        if respiratoryRate > 0 { rInputs.respiratoryRate = rMetric("rr", respiratoryRate) }

        let rReport = RecoveryEngine().computeReport(from: rInputs)

        DispatchQueue.main.async {
            self.longevityReport = lReport
            self.recoveryReport = rReport
        }
    }

    // Gathers real daily-series baselines via HKStatisticsCollectionQuery and
    // recomputes both reports once all series have returned.
    private func refreshBaselinesAndRecompute() {
        let group = DispatchGroup()
        var series: [String: [Double]] = [:]
        let lock = NSLock()

        func store(_ key: String, _ values: [Double]) {
            lock.lock(); series[key] = values; lock.unlock()
        }

        // (identifier, key, unit, statistics option, days)
        let discreteAvg = HKStatisticsOptions.discreteAverage
        let cumSum = HKStatisticsOptions.cumulativeSum

        func addSeries(_ id: HKQuantityTypeIdentifier, _ key: String, _ unit: HKUnit, _ opt: HKStatisticsOptions, days: Int) {
            guard let type = HKQuantityType.quantityType(forIdentifier: id) else { return }
            group.enter()
            dailySeries(type: type, unit: unit, option: opt, days: days) { values in
                store(key, values)
                group.leave()
            }
        }

        // Longevity baselines: 21 days.
        addSeries(.vo2Max, "vo2Max", HKUnit(from: "ml/kg*min"), discreteAvg, days: 21)
        addSeries(.heartRateVariabilitySDNN, "hrvSDNN", HKUnit(from: "ms"), discreteAvg, days: 21)
        addSeries(.restingHeartRate, "restingHR", HKUnit(from: "count/min"), discreteAvg, days: 21)
        addSeries(.walkingSpeed, "walkingSpeed", HKUnit.meter().unitDivided(by: .second()), discreteAvg, days: 21)
        addSeries(.stepCount, "steps", HKUnit.count(), cumSum, days: 21)
        addSeries(.appleExerciseTime, "exerciseMinutes", HKUnit.minute(), cumSum, days: 21)
        addSeries(.heartRateRecoveryOneMinute, "heartRateRecovery", HKUnit(from: "count/min"), discreteAvg, days: 21)
        // Recovery baseline: respiratory rate (14 days).
        addSeries(.respiratoryRate, "rr", HKUnit.count().unitDivided(by: .minute()), discreteAvg, days: 14)

        // Sleep daily series (21 days) requires a category-sample aggregation.
        group.enter()
        sleepDailySeries(days: 21) { values in
            store("sleepHours", values)
            group.leave()
        }

        group.notify(queue: .main) { [weak self] in
            guard let self = self else { return }
            // Longevity uses the full 21-day arrays as baseline; recent = last 7.
            var longevity: [String: [Double]] = [:]
            for k in ["vo2Max", "hrvSDNN", "restingHR", "walkingSpeed", "steps", "exerciseMinutes", "heartRateRecovery", "sleepHours"] {
                if let v = series[k], !v.isEmpty { longevity[k] = v }
            }
            // Recovery baselines (14 days) for HRV/sleep/RHR/RR — reuse trailing 14.
            var recovery: [String: [Double]] = [:]
            recovery["hrv"] = Array((series["hrvSDNN"] ?? []).suffix(14))
            recovery["sleep"] = Array((series["sleepHours"] ?? []).suffix(14))
            recovery["rhr"] = Array((series["restingHR"] ?? []).suffix(14))
            recovery["rr"] = series["rr"] ?? []
            self.computeReportsWithBaselines(longevityBaselines: longevity, recoveryBaselines: recovery)
        }
    }

    // Generic daily-aggregate series over the trailing `days` days.
    private func dailySeries(type: HKQuantityType, unit: HKUnit, option: HKStatisticsOptions, days: Int,
                             completion: @escaping ([Double]) -> Void) {
        let cal = Calendar.current
        let anchor = cal.startOfDay(for: Date())
        guard let start = cal.date(byAdding: .day, value: -days, to: anchor) else {
            completion([]); return
        }
        let predicate = HKQuery.predicateForSamples(withStart: start, end: Date(), options: .strictStartDate)
        var interval = DateComponents(); interval.day = 1

        let query = HKStatisticsCollectionQuery(quantityType: type,
                                                quantitySamplePredicate: predicate,
                                                options: option,
                                                anchorDate: anchor,
                                                intervalComponents: interval)
        query.initialResultsHandler = { _, results, _ in
            var values: [Double] = []
            results?.enumerateStatistics(from: start, to: Date()) { stat, _ in
                let q = option.contains(.cumulativeSum) ? stat.sumQuantity() : stat.averageQuantity()
                if let q = q {
                    let v = q.doubleValue(for: unit)
                    if v.isFinite && v > 0 { values.append(v) }
                }
            }
            completion(values)
        }
        healthStore.execute(query)
    }

    // Per-day asleep-hours series over the trailing `days` days.
    private func sleepDailySeries(days: Int, completion: @escaping ([Double]) -> Void) {
        guard let sleepType = HKObjectType.categoryType(forIdentifier: .sleepAnalysis) else {
            completion([]); return
        }
        let cal = Calendar.current
        let end = Date()
        guard let start = cal.date(byAdding: .day, value: -days, to: cal.startOfDay(for: end)) else {
            completion([]); return
        }
        let predicate = HKQuery.predicateForSamples(withStart: start, end: end, options: [])
        let query = HKSampleQuery(sampleType: sleepType, predicate: predicate, limit: HKObjectQueryNoLimit, sortDescriptors: nil) { _, results, _ in
            guard let samples = results as? [HKCategorySample] else { completion([]); return }
            // Bucket asleep intervals by calendar day of their start date.
            var perDay: [Date: TimeInterval] = [:]
            for s in samples {
                // 1: asleep/asleepUnspecified, 3: asleepDeep, 4: asleepREM, 5: asleepCore
                let v = s.value
                guard v == 1 || v == 3 || v == 4 || v == 5 else { continue }
                let day = cal.startOfDay(for: s.startDate)
                perDay[day, default: 0] += s.endDate.timeIntervalSince(s.startDate)
            }
            let hours = perDay.values.map { $0 / 3600.0 }.filter { $0 > 0 }
            completion(hours)
        }
        healthStore.execute(query)
    }
}
