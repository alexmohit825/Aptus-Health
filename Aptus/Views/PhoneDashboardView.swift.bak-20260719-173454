    /// Push the latest coaching result to the Apple Watch so it renders on the
    /// telemetry view without a separate network round-trip on the Watch.
    func pushCoachingToWatch() {
        let payload = CoachingPayload(
            recoveryScore: recoveryScore,
            targetZone: targetZone,
            instruction: coachingResponse,
            adjustedPlan: planAdjust
        )
        ConnectivityManager.shared.sendCoaching(payload)
    }

    /// Forward live biometric samples streamed from the Watch to the realtime
    /// coaching endpoint (so the AI sees actual heart-rate data, not mocks).
    func forwardLiveSample(_ sample: BiometricSample) {
        guard let url = URL(string: "\(serverURL)/api/coaching/realtime-step") else { return }
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        let payload: [String: Any] = [
            "kind": sample.kind.rawValue,
            "value": sample.value,
            "timestamp": ISO8601DateFormatter().string(from: sample.timestamp)
        ]
        request.httpBody = try? JSONSerialization.data(withJSONObject: payload)
        URLSession.shared.dataTask(with: request) { _, _, _ in }.resume()
    }

