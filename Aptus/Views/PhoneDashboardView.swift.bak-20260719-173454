    // Communicate with React application API
    func syncWithAnalyticsEngine() {
        isLoading = true
        guard let url = URL(string: "\(serverURL)/api/coaching/daily") else {
            isLoading = false
            self.computeOnDeviceFallback(reason: "Invalid server URL")
            return
        }
        
        var request = URLRequest(url: url)
        request.httpMethod = "POST"
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        
        let payload: [String: Any] = [
            "hrv": hkManager.currentHRV > 0 ? hkManager.currentHRV : 72.0,
            "rhr": hkManager.restingHR > 0 ? hkManager.restingHR : 53.0,
            "sleepDuration": hkManager.sleepHoursLastNight > 0 ? hkManager.sleepHoursLastNight : 7.9,
            "sleepEfficiency": 92.0,
            "stressLevel": 35,
            "acuteTrainingLoad": 310,
            "chronicTrainingLoad": 280,
            "fatigueIndex": 40,
            "svO2": hkManager.svO2 > 0 ? hkManager.svO2 : 74,
            "vo2Max": hkManager.vo2Max > 0 ? hkManager.vo2Max : 51.5,
            "heartRateRecovery": hkManager.heartRateRecovery > 0 ? hkManager.heartRateRecovery : 42
        ]
        
        request.httpBody = try? JSONSerialization.data(withJSONObject: payload)
        
        URLSession.shared.dataTask(with: request) { data, response, error in
            DispatchQueue.main.async {
                self.isLoading = false
                
                if let error = error {
                    print("[Aptus] Network error calling AI Insights: \(error.localizedDescription)")
                    self.computeOnDeviceFallback(reason: "Offline / Network issue: \(error.localizedDescription)")
                    return
                }
                
                guard let httpResponse = response as? HTTPURLResponse else {
                    print("[Aptus] Invalid response received from server")
                    self.computeOnDeviceFallback(reason: "Invalid server response format")
                    return
                }
                
                print("[Aptus] Server returned status code: \(httpResponse.statusCode)")
                if httpResponse.statusCode != 200 {
                    print("[Aptus] Non-200 response from server: \(httpResponse.statusCode)")
                    self.computeOnDeviceFallback(reason: "Server returned code \(httpResponse.statusCode)")
                    return
                }
                
                guard let data = data else {
                    print("[Aptus] No data returned from server")
                    self.computeOnDeviceFallback(reason: "Empty server payload")
                    return
                }
                
                do {
                    guard let json = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
                        print("[Aptus] Could not parse response as JSON dictionary")
                        self.computeOnDeviceFallback(reason: "Response was not structured JSON (e.g. redirected webpage)")
                        return
                    }
                    
                    print("[Aptus] Received JSON response: \(json)")
                    
                    guard let recovery = json["recoveryStatus"] as? [String: Any],
                          let intensity = json["recommendedIntensity"] as? [String: Any],
                          let adjustment = json["planAdjustment"] as? [String: Any] else {
                        print("[Aptus] JSON response missing expected keys")
                        self.computeOnDeviceFallback(reason: "Missing expected response fields")
                        return
                    }
                    
                    self.recoveryScore = recovery["score"] as? Int ?? 0
                    self.coachingResponse = recovery["description"] as? String ?? ""
                    self.targetZone = intensity["targetHeartRateZone"] as? String ?? ""
                    self.planAdjust = adjustment["adjustedPlan"] as? String ?? ""
                    self.pushCoachingToWatch()
                } catch {
                    print("[Aptus] JSON Parsing error: \(error.localizedDescription)")
                    self.computeOnDeviceFallback(reason: "JSON Format Error: \(error.localizedDescription)")
                }
            }
        }.resume()
    }
    
    // High-fidelity Sports-Science Engine implemented locally as a fallback
    func computeOnDeviceFallback(reason: String) {
        print("[Aptus] Running on-device Athletic Analytics Fallback. Reason: \(reason)")
        
        let hrvVal = hkManager.currentHRV > 0 ? hkManager.currentHRV : 72.0
        let rhrVal = hkManager.restingHR > 0 ? hkManager.restingHR : 53.0
        let sleepVal = hkManager.sleepHoursLastNight > 0 ? hkManager.sleepHoursLastNight : 7.9
        let svO2Val = hkManager.svO2 > 0 ? hkManager.svO2 : 74
        let vo2MaxVal = hkManager.vo2Max > 0 ? hkManager.vo2Max : 51.5
        let hrrVal = hkManager.heartRateRecovery > 0 ? hkManager.heartRateRecovery : 42
        let stressVal = 35.0
        let fatigueVal = 40.0
        
        // 1. Calculate recovery score
        var score = 50.0
        score += (hrvVal - 55.0) * 0.8
        let sleepDiff = sleepVal - 8.0
        score -= abs(sleepDiff) * 8.0
        score += (55.0 - rhrVal) * 1.5
        score -= (stressVal - 30.0) * 0.4
        if hrrVal > 30 {
            score += Double(hrrVal - 30) * 0.5
        } else if hrrVal < 20 {
            score -= Double(20 - hrrVal) * 1.0
        }
        if svO2Val < 63 {
            score -= Double(63 - svO2Val) * 1.5
        }
        let finalScore = max(10, min(100, Int(round(score))))
        
        // 2. Status
        var statusStr = "Recovering"
        if finalScore >= 80 {
            statusStr = "Optimal"
        } else if finalScore >= 55 {
            statusStr = "Recovering"
        } else if stressVal > 70.0 || rhrVal > 60.0 {
            statusStr = "Strained"
        } else {
            statusStr = "Deconditioned"
        }
        
        // 3. Recommended Intensity & Zone
        var intensityStr = "Aerobic/Base"
        var targetHRZone = "Zone 2 & 3: 120 - 155 bpm"
        var coachDesc = ""
        
        if statusStr == "Optimal" {
            intensityStr = "Tempo/Threshold"
            targetHRZone = "Zone 4: 156 - 175 bpm"
            coachDesc = "Your autonomic nervous system is fully primed. Elevated HRV (\(Int(hrvVal))ms), low RHR (\(Int(rhrVal))bpm), and high VO2 Max of \(String(format: "%.1f", vo2MaxVal)) signify high cardiorespiratory readiness. Excellent day for a threshold session."
        } else if statusStr == "Recovering" {
            intensityStr = "Aerobic/Base"
            targetHRZone = "Zone 2 & 3: 120 - 155 bpm"
            coachDesc = "Nervous system is in stable equilibrium. With oxygen saturation (SvO2) at \(Int(svO2Val))% and HR recovery of \(Int(hrrVal)) bpm, maintain solid aerobic baseline. Keep effort conversational."
        } else {
            intensityStr = "Active Recovery"
            targetHRZone = "Zone 1: Under 120 bpm"
            coachDesc = "Nervous strain or fatigue detected. Heart Rate Recovery has slowed to \(Int(hrrVal)) bpm. Lower your intensity, focus on active mobility, hydration, and restoring oxygen delivery today."
        }
        
        let adjustedPlanStr = statusStr == "Optimal" ? "10km Tempo Run + 3x 1min fast strides" : (statusStr == "Strained" ? "30min Easy Zone 1 Recovery Jog or Active Rest" : "8km Steady Base Aerobic Run")
        
        // Update states on-screen
        self.recoveryScore = finalScore
        self.coachingResponse = "On-Device Engine: \(coachDesc)"
        self.targetZone = targetHRZone
        self.planAdjust = "Adjusted plan: \(adjustedPlanStr) (On-Device Fallback)"
        self.pushCoachingToWatch()
    }
